# PostgreSQL deployment URL. Omit for local SQLite fallback.
# DATABASE_URL=postgresql+psycopg://milestone:milestone@127.0.0.1:5432/milestone
JWT_SECRET=replace-with-a-long-random-secret

# Optional PayPal sandbox integration. Leave blank for safe no-money demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://127.0.0.1:5173
PAYPAL_CANCEL_URL=http://127.0.0.1:5173

# Optional OpenAI-compatible advisory review. Leave blank for deterministic-only mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
